set -eu

SBO_VER="15.0"
SBO_RSYNC="rsync://slackbuilds.org/slackbuilds/$SBO_VER"

WORKBASE="/tmp/sbmk"
INDEX="$WORKBASE/SLACKBUILDS.TXT"

KEEP=0
SHOW_DEPS=0

usage() {
  echo "usage: sbmk PACKAGE [--deps] [--keep]"
  exit 1
}

[ $# -lt 1 ] && usage

PKG="$1"
shift

for a in "$@"; do
  case "$a" in
    --deps) SHOW_DEPS=1 ;;
    --keep) KEEP=1 ;;
    *) usage ;;
  esac
done

# must be root
[ "$(id -u)" -ne 0 ] && { echo "sbmk: must be run as root"; exit 1; }

mkdir -p "$WORKBASE"

# fetch index
if [ ! -f "$INDEX" ]; then
  echo "==> fetching SLACKBUILDS.TXT"
  rsync "$SBO_RSYNC/SLACKBUILDS.TXT" "$INDEX"
fi

# locate package
found=0
loc=""

while IFS= read -r line; do
  case "$line" in
    "SLACKBUILD NAME: $PKG") found=1 ;;
    "SLACKBUILD LOCATION:"*)
      if [ "$found" -eq 1 ]; then
        loc=${line#SLACKBUILD LOCATION: }
        break
      fi
      ;;
  esac
done < "$INDEX"

[ -z "$loc" ] && { echo "sbmk: package not found: $PKG"; exit 1; }

loc=${loc#./}

# prepare work dir
WORK="$WORKBASE/$PKG"
mkdir -p "$WORK"

echo "==> fetching SlackBuild: $loc"
rsync -a "$SBO_RSYNC/$loc/" "$WORK/"

cd "$WORK"

# parse .info
REQUIRES=""
DOWNLOAD=""
DOWNLOAD_X86_64=""

while IFS= read -r line; do
  case "$line" in
    REQUIRES=*)
      REQUIRES=${line#REQUIRES=}
      REQUIRES=${REQUIRES#\"}
      REQUIRES=${REQUIRES%\"}
      ;;
    DOWNLOAD=*)
      DOWNLOAD=${line#DOWNLOAD=}
      DOWNLOAD=${DOWNLOAD#\"}
      DOWNLOAD=${DOWNLOAD%\"}
      ;;
    DOWNLOAD_x86_64=*)
      DOWNLOAD_X86_64=${line#DOWNLOAD_x86_64=}
      DOWNLOAD_X86_64=${DOWNLOAD_X86_64#\"}
      DOWNLOAD_X86_64=${DOWNLOAD_X86_64%\"}
      ;;
  esac
done < "$PKG.info"

ARCH=$(uname -m)

if [ "$ARCH" = "x86_64" ] && [ -n "$DOWNLOAD_X86_64" ]; then
  DOWNLOADS="$DOWNLOAD_X86_64"
elif [ -n "$DOWNLOAD" ] && [ "$DOWNLOAD" != "UNSUPPORTED" ]; then
  DOWNLOADS="$DOWNLOAD"
else
  echo "sbmk: $PKG unsupported on $ARCH"
  exit 1
fi

if [ "$SHOW_DEPS" -eq 1 ]; then
  echo "${REQUIRES:-none}"
  exit 0
fi

# download sources into CWD
fetch() {
  url="$1"
  file=${url##*/}

  [ -f "$file" ] && return 0

  if command -v curl >/dev/null 2>&1; then
    curl -L -o "$file" "$url"
  else
    wget -O "$file" "$url"
  fi
}

for url in $DOWNLOADS; do
  echo "==> downloading $(basename "$url")"
  fetch "$url"
done

# build (DO NOT override TMP)
echo "==> building $PKG"
[ -n "$REQUIRES" ] && echo "==> requires: $REQUIRES"

sh "$PKG.SlackBuild"

# cleanup
[ "$KEEP" -ne 1 ] && rm -rf "$WORK"

