# t — minimal todo.txt manager
# Plain text tasks, manual priorities, honest sorting.

todo_dir="${TODOTXT_DIR:-$HOME/projects/personal/todo}"
todo_file="$todo_dir/todo.txt"
editor="${VISUAL:-${EDITOR:-neatvi}}"

# Print active tasks in the same order used by `list` and `done <number>`.
# The source line number is kept as a tie-breaker, so tasks with the same
# priority do not jump around between invocations.
sorted_tasks() {
    nl -ba "$todo_file" \
    | awk '
        {
            line = $1
            $1 = ""
            sub(/^[[:space:]]+/, "")
            text = $0
            if (text == "")
                next
            prio = "Z"
            if (match(text, /\([A-Z]\)/))
                prio = substr(text, RSTART + 1, 1)
            printf "%s\t%08d\t%s\n", prio, line, text
        }
    ' \
    | sort -t "$(printf '\t')" -k1,1 -k2,2n
}

mkdir -p "$todo_dir" || exit 1
touch "$todo_file" || exit 1

cmd="$1"

case "$cmd" in
    ""|edit|e)
        exec "$editor" "$todo_file"
        ;;

    list|l)
        printf "\n"
        sorted_tasks \
        | awk -F '\t' '
            {
                if ($1 != previous) {
                    if (NR > 1) print ""
                    label = ($1 == "Z" ? "none" : $1)
                    printf "[%s]\n", label
                    previous = $1
                }
                printf "%2d %s\n", ++number, $3
            }
        '
        printf "\n"
        ;;

    add|a)
        shift
        [ -z "$*" ] && {
            echo "Usage: t add <task>" >&2
            exit 1
        }
        printf '%s\n' "$*" >>"$todo_file"
        echo "[+] $*"
        ;;

    done|d)
        shift
        [ -z "$1" ] && {
            echo "Usage: t done <number|pattern>" >&2
            exit 1
        }

        tmp=$(mktemp) || exit 1

        # Numeric done (maps list number -> file line)
        if printf '%s' "$1" | grep -Eq '^[0-9]+$'; then
            line=$(
                sorted_tasks \
                | sed -n "${1}p" \
                | cut -f2
            )

            [ -z "$line" ] && {
                echo "error: no such task number: $1" >&2
                rm -f "$tmp"
                exit 1
            }

            sed "${line}{
                /^[[:space:]]*x /!s/^/x /
            }" "$todo_file" >"$tmp"

            mv "$tmp" "$todo_file"
            echo "[✓] Marked done: task #$1"
            exit 0
        fi

        # Pattern-based done
        safe=$(printf '%s' "$1" | sed 's/[][\/.^$*]/\\&/g')

        sed "0,/^.*$safe.*/{
            /^[[:space:]]*x /!s/^/x /
        }" "$todo_file" >"$tmp"

        mv "$tmp" "$todo_file"
        echo "[✓] Marked done: $1"
        ;;

    push|p)
        (
            cd "$todo_dir" || exit 1
            git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
            git add todo.txt
            git commit -m "todo: update $(date +%Y-%m-%d)" >/dev/null 2>&1 || true
            git push
        )
        ;;

    help|-h|--help)
        cat <<EOF
t — minimal todo.txt manager

Usage:
  t                 Edit todo.txt (default)
  t edit | e         Edit todo.txt
  t list | l         List tasks (sorted, numbered)
  t add  | a <task>  Add a new task
  t done | d <n|re>  Mark task done (number or pattern)
  t push | p         Commit & push changes to git

Notes:
- Tasks are plain text
- Priorities are manual: (A), (B), (C)...
- Sorting is a view; the file is the source of truth

Examples:

  # Add tasks with priority
  t add "(A) Finish article about aerc + postfix + mbsync"
  t add "(B) Review SlackBuild for bsddialog"
  t add "(C) Test Slackware installer GRUB support"

  # Add a quick task
  t add Write short note about nvi workflow

  # List tasks (sorted and numbered)
  t list

  # Mark task done by number
  t done 2

  # Or mark done by pattern
  t done bsddialog

  # Commit and push (if todo.txt is in a git repo)
  t push

Environment:
  TODOTXT_DIR   Path to todo directory (default: ~/projects/personal/todo)
  EDITOR/VISUAL Preferred editor (default: nvi)
EOF
        ;;

    *)
        echo "Invalid command. Use: t help" >&2
        exit 1
        ;;
esac
